{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:security": "node tests/security/bypass.mjs",
    "test:faults": "node tests/faults/run.mjs",
    "test:oauth": "node tests/oauth/clean-run.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "db:migrate": "for f in apps/api/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "policy:keygen": "tsx tools/policy-publisher/src/index.ts keygen",
    "policy:trust": "tsx tools/policy-publisher/src/index.ts trust",
    "policy:publish": "tsx tools/policy-publisher/src/index.ts publish",
    "policy:status": "tsx tools/policy-publisher/src/index.ts status",
    "audit:verify": "tsx scripts/verify-audit.mts",
    "audit:checkpoint": "tsx scripts/audit-checkpoint.mts",
    "deps:check": "node scripts/dependency-audit.mjs",
    "deps:sbom": "node scripts/dependency-audit.mjs --sbom sbom.cdx.json",
    "deps:advisories": "node scripts/advisory-audit.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:audit": "node scripts/demo.mjs audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.16.0",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.8.1"
  }
}
