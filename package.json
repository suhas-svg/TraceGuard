{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "examples/demo-agent-ts",
    "packages/audit-chain",
    "packages/canonical-json",
    "packages/mcp-client-shim",
    "packages/policy-signing",
    "packages/schemas",
    "sdks/typescript",
    "tools/policy-publisher"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:security": "node tests/security/bypass.mjs",
    "test:faults": "node tests/faults/run.mjs",
    "test:oauth": "node tests/oauth/clean-run.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "db:migrate": "for f in apps/api/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "policy:keygen": "tsx tools/policy-publisher/src/index.ts keygen",
    "policy:trust": "tsx tools/policy-publisher/src/index.ts trust",
    "policy:publish": "tsx tools/policy-publisher/src/index.ts publish",
    "policy:status": "tsx tools/policy-publisher/src/index.ts status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.16.0",
    "typescript-eslint": "^8.71.2"
  }
}
