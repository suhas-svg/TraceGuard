{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "examples/demo-agent-ts",
    "packages/canonical-json",
    "packages/mcp-client-shim",
    "packages/schemas",
    "sdks/typescript"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:migrate": "for f in apps/api/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
