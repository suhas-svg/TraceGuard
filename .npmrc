# The Compose reference mounts the host node_modules tree read-only into the
# mock-tools container, which resolves @modelcontextprotocol/sdk and zod from
# the repository root. A hoisted node_modules keeps that layout working; the
# isolated linker would only expose them under apps/api/node_modules.
node-linker=hoisted
link-workspace-packages=true
prefer-workspace-packages=true
