POSTGRES_USER=traceguard
POSTGRES_PASSWORD=traceguard_dev_only
POSTGRES_DB=traceguard
DATABASE_URL=postgres://traceguard:traceguard_dev_only@localhost:5432/traceguard
API_KEY=dev_key_change_me
APPROVER_KEY=dev_approver_change_me
# 32 bytes hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_ARGS_KEY=
APPROVAL_TTL_SECONDS=300
# Keep the previous seal key only while rotating APPROVAL_ARGS_KEY so pending approvals stay readable.
APPROVAL_ARGS_KEY_PREVIOUS=
ALLOW_PRIVATE_UPSTREAMS=true
# Must match the dashboard's VITE_API_URL default (http://localhost:8090) and the
# README's dev ports, or a bare local API comes up on a port the dashboard never
# calls. Compose overrides this with PORT=8080 inside the container and publishes
# it on 8090, so both paths land the public API on 8090.
PORT=8090
GATEWAY_PORT=8091
DASHBOARD_ORIGIN=http://localhost:5173
# Raw prompts/responses/tool args are dropped before persistence unless true; recognized secrets are always redacted.
CAPTURE_RAW_ATTRIBUTES=false
# Advisory diagnostics thresholds (FR-010). Warnings only; nothing is blocked.
DIAG_MAX_CALLS=50
DIAG_MAX_DURATION_MS=1800000
DIAG_MAX_TOKENS=1000000
DIAG_REPEATED_FAILURES=3
# Ceiling on one upstream MCP exchange, in milliseconds. Aborts the HTTP request
# itself, not just the protocol wait.
UPSTREAM_TIMEOUT_MS=60000
