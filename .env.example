POSTGRES_USER=traceguard
POSTGRES_PASSWORD=traceguard_dev_only
POSTGRES_DB=traceguard
DATABASE_URL=postgres://traceguard:traceguard_dev_only@localhost:5432/traceguard
# Passwords for the least-privilege role logins (§13.4). The compose `db-roles`
# service applies the migrations and enables these logins on every `up`; the
# api, gateway and retention sweep each connect with their own role. Change
# them for anything beyond a local dev box.
API_DB_PASSWORD=api_dev_pw
GATEWAY_DB_PASSWORD=gateway_dev_pw
RETENTION_DB_PASSWORD=retention_dev_pw
PUBLISHER_DB_PASSWORD=publisher_dev_pw
API_KEY=dev_key_change_me
APPROVER_KEY=dev_approver_change_me
# 32 bytes hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_ARGS_KEY=
APPROVAL_TTL_SECONDS=900
# How long a consume attempt may hold the CLAIMED lease before the queue sweep
# returns the approval to APPROVED (crash without an execution intent).
APPROVAL_CLAIM_LEASE_SECONDS=30

# Audit checkpoints (§10.2/FR-019). The gateway only needs the public key to
# verify operator-signed checkpoints. The private key stays on the operator
# host and is used by `npm run audit:checkpoint`; never commit a real key.
AUDIT_CHECKPOINT_PUBLIC_KEY=
# Keep the previous seal key only while rotating APPROVAL_ARGS_KEY so pending approvals stay readable.
APPROVAL_ARGS_KEY_PREVIOUS=
ALLOW_PRIVATE_UPSTREAMS=true
# Must match the dashboard's VITE_API_URL default (http://localhost:8090) and the
# README's dev ports, or a bare local API comes up on a port the dashboard never
# calls. Compose overrides this with PORT=8080 inside the container and publishes
# it on 8090, so both paths land the public API on 8090.
PORT=8090
GATEWAY_PORT=8091
# §9: the human approval queue and decisions run on this separate control
# listener; agent credentials are rejected there. DASHBOARD_ORIGIN applies to both.
GATEWAY_CONTROL_PORT=8093
DASHBOARD_ORIGIN=http://localhost:5173
# Raw prompts/responses/tool args are dropped before persistence unless true; recognized secrets are always redacted.
CAPTURE_RAW_ATTRIBUTES=false
# Advisory diagnostics thresholds (FR-010). Warnings only; nothing is blocked.
DIAG_MAX_CALLS=50
DIAG_MAX_DURATION_MS=1800000
DIAG_MAX_TOKENS=1000000
DIAG_REPEATED_FAILURES=3
# OTLP trace ingestion bounds (§11). Oversized requests are rejected; spans past
# the per-request cap come back as partial success with reasons; starts older
# than the late window are refused, and a start ahead of receipt flags clock_skew.
OTLP_MAX_BODY_BYTES=1048576
OTLP_MAX_SPANS=2000
OTLP_MAX_ATTRIBUTES=64
OTLP_MAX_ATTR_STRING=4096
OTLP_SKEW_THRESHOLD_MS=300000
OTLP_LATE_WINDOW_MS=86400000
OTLP_RATE_SPANS_PER_MINUTE=60000
# Ceiling on one upstream MCP exchange, in milliseconds. Aborts the HTTP request
# itself, not just the protocol wait.
UPSTREAM_TIMEOUT_MS=60000
# Where the gateway records the highest signed policy version it accepted
# (§13.3). Must persist across restarts, or a rolled-back pointer cannot be
# told from a fresh deployment.
GATEWAY_STATE_DIR=./gateway-state
# §7.5: only these `_meta` keys on a tool definition are covered by its pin
# hash. Empty pins no metadata at all.
TOOL_PIN_META_ALLOWLIST=
# The operator-side policy publisher's private key path (tools/policy-publisher).
# The key never belongs in the API or gateway containers.
POLICY_SIGNING_KEY_FILE=./policy-keys/signing-key.pem
# Optional OAuth 2.1 resource-server mode (§7.3). Set all three (issuer,
# audience, and one JWKS source) to authenticate callers with real access
# tokens instead of the static keys above; the audience is the canonical
# resource URI this deployment answers on, e.g. http://localhost:8091/mcp.
# Left empty, the static development keys are the profile. With
# NODE_ENV=production these are required: startup is refused without them and
# API_KEY/APPROVER_KEY stop authenticating.
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_FILE=
OAUTH_JWKS_URL=
